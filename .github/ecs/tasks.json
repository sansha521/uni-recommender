{
  "family": "uni-rec-ai-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::514585225124:role/uni-rec-ecs-role",
  "taskRoleArn": "arn:aws:iam::514585225124:role/uni-rec-ecs-app-role",
  "containerDefinitions": [
    {
      "name": "ai-service",
      "image": "<IMAGE>",
      "cpu": 2048,
      "memory": 4096,
      "memoryReservation": 2048,
      "essential": true,
        "environmentFiles": [
            {
                "value": "arn:aws:s3:::unirec-s3-bucket/uni-rec-ai.env",
                "type": "s3"
            }
        ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 90
      },
      "portMappings": [
        {
          "name": "ai_service_container-tcp",
          "appProtocol": "http",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uni-rec-ai-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

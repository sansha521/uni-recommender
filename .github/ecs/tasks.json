{
  "family": "uni-rec-ai-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
    "environmentFiles": [
        {
            "value": "arn:aws:s3:::unirec-s3-bucket/uni-rec-ai.env",
            "type": "s3"
        }
    ],
  "executionRoleArn": "arn:aws:iam::514585225124:role/uni-rec-ecs-role",
  "taskRoleArn": "arn:aws:iam::514585225124:role/uni-rec-ecs-app-role",
  "containerDefinitions": [
    {
      "name": "ai-service",
      "image": "<IMAGE>",
      "cpu": 2048,
      "memory": 4096,
      "memoryReservation": 2048,
      "essential": true,
      "portMappings": [
        {
          "name": "ai_service_container-tcp",
          "appProtocol": "http",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/uni-rec-ai-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}

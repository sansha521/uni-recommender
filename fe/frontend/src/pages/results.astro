---
import Header from '../components/Header.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Results</title>
  </head>
  <body>
    <Header />
    <h1>Your Top University Recommendations</h1>

    <div id="recommendations"></div>
  </body>
</html>

<script>
  type Recommendation = { name: string; reasoning: string };

  const raw = new URLSearchParams(window.location.search).get('data') || '[]';

  let recommendations: Recommendation[] = [];
  try {
    recommendations = JSON.parse(raw);
  } catch (error) {
    console.error('Could not parse recommendations:', error);
  }

  const container = document.getElementById('recommendations');
  if (container) {
    recommendations.forEach((rec, i) => {
      const wrapper = document.createElement('div');

      const title = document.createElement('h2');
      title.textContent = `${i + 1}. ${rec.name}`;

      const reasoning = document.createElement('p');
      reasoning.textContent = rec.reasoning;

      wrapper.append(title, reasoning);
      container.append(wrapper);
    });
  }
</script>

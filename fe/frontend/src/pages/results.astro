  function addBubble(role: 'user' | 'assistant', text: string) {
    const el = document.createElement('div');
    el.className = `bubble bubble--${role}`;
    el.textContent = text;
    msgList.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return el;
  }

  function addLoading() {
    const el = document.createElement('div');
    el.className = 'bubble--loading';
    el.textContent = 'Thinking…';
    msgList.appendChild(el);
    el.scrollIntoView({ behavior: 'smooth', block: 'end' });
    return el;
  }

  // ── Initial render ────────────────────────────────────────────────
  renderRecs(recommendations);

  // ── Send ──────────────────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = input.value.trim();
    if (!msg) return;

    input.value = '';
    sendBtn.disabled = true;
    addBubble('user', msg);
    const spinner = addLoading();

    try {
      const res = await fetch(`${API_URL}chat/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          original_context: context,
          current_recommendations: recommendations,
          conversation_history: history,
          new_message: msg,
        }),
      });

      if (!res.ok) throw new Error(`${res.status}`);
      const data = await res.json();
      spinner.remove();

      if (data.type === 'recommendations') {
        recommendations = data.recommendations;
        renderRecs(recommendations);
        const reply = "I've updated your recommendations based on that — take a look on the left.";
        addBubble('assistant', reply);
        history.push({ role: 'user', content: msg }, { role: 'assistant', content: reply });
      } else {
        addBubble('assistant', data.content);
        history.push({ role: 'user', content: msg }, { role: 'assistant', content: data.content });
      }
    } catch {
      spinner.remove();
      addBubble('assistant', 'Something went wrong — please try again.');
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  });
</script>

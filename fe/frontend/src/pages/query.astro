---
// src/pages/user_query_form.astro
import { Select } from 'free-astro-components'
import Header from '../components/Header.astro';
// const title = "About Me";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- <title>{title}</title> -->
  </head>
  <body>
    <Header />
      <!-- <h1>{title}</h1> -->
      <p>Find your dream university!</p>
    <h1>Tell us a bit about what you are looking for...</h1>
    <form>
      <label>
        Budget range
        <Select
          name="budget_min"
          label="Lowest budget point"
          options={[
            { value: '0', label: '0' },
            { value: '5000', label: '5,000' },
            { value: '7500', label: '7,500' },
            { value: '10000', label: '10,000'},
            { value: '30000', label: '30,000'},
            { value: '50000', label: '50,000'}
          ]}
          placeholder="Cannot select"
        />
        <Select
          name="budget_max"
          label="Highest budget point"
          options={[
            { value: '5000', label: '5,000' },
            { value: '75000', label: '75,000' },
            { value: '10000', label: '10,000' },
            { value: '30000', label: '30,000' },
            { value: '50000', label: '50,000 '},
            { value: '100000', label: '100,000'}
          ]}
          placeholder="Cannot select"
        />
      </label>
      <label>
        Score type
        <Select
          name="score_type"
          label="Score type"
          options={[
            { value: 'ACT', label: 'ACT' },
            { value: 'SAT', label: 'SAT' }
          ]}
          placeholder="Cannot select"
        />
      </label>
      <label>
        Score
        <input type="number" name="score" />
      </label>
      <label>
        Region
        <Select
          name="region"
          label="Choose the region that you want to study in."
          options={[
            { value: 'northeast', label: 'northeast' },
            { value: 'midatlantic', label: 'midatlantic' },
            { value: 'midwest', label: 'midwest' },
            { value: 'west', label: 'west' },
            { value: 'southeast', label: 'southeast'},
            { value: 'southwest', label: 'southwest'},
            { value: 'northwest', label: 'northwest'}
          ]}
          placeholder="Cannot select"
        />
      </label>
      <label>
        Any qualities that you are looking for in a university
        <textarea
          name="qualities"
          placeholder="e.g. small campus, strong CS program, warm climate"
        ></textarea>
      </label>
      <button>Submit</button>
    </form>
  </body>
</html>


<script>
  import { actions } from 'astro:actions';
  import { navigate } from 'astro:transitions/client';

  const form = document.querySelector('form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    let query = formData.entries()
    const { error } = await actions.userquery(formData);
  })
</script>

---
// src/components/Navigation.astro
const links = [
  { href: "/", label: "Home" },
  { href: "/query/", label: "Find Universities" },
  // { href: "/results/", label: "About" },
  { href: "/behind/", label: "Behind the Scenes" },
  // { href: "/chat/", label: "Chat with Campi" },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<nav id="main-menu" class="nav-bar">
  <a href="/" class="nav-brand">
    <img src="/icon.png" alt="CampusMatch" class="nav-logo" />
    <span class="nav-wordmark">CampusMatch</span>
  </a>

  <div class="nav-links">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap");

  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 3rem;
    padding: 0.85rem 2rem;
    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.25);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Brand */
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .nav-logo {
    height: 22px;
    width: auto;
    /* the source mark is solid black on transparent; force it to white */
    filter: brightness(0) invert(1);
  }

  .nav-wordmark {
    font-family: Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans",
      Arial, sans-serif;
    color: #f8fafc;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.01em;
  }

  /* Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0.9rem;
    border-radius: 0.5rem;
    color: #cbd5e1;
    text-decoration: none;
    font-family: Poppins, sans-serif;
    font-weight: 500;
    font-size: 0.95rem;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.3rem;
    height: 2px;
    border-radius: 2px;
    background: #60a5fa;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .nav-link[aria-current="page"] {
    color: #ffffff;
  }

  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav-link:focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 2px;
  }

  @media (max-width: 520px) {
    .nav-bar {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
    }

    .nav-links {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
